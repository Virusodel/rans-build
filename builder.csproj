<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>ARES-7 Ransomware Builder</AssemblyTitle>
    <AssemblyDescription>v8.0 TCC Builder</AssemblyDescription>
    <RootNamespace>RansomwareBuilder</RootNamespace>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- TCC компилятор встроен в ресурсы -->
    <EmbeddedResource Include="tcc.exe" />
  </ItemGroup>
</Project>
